# Optional: set this to your CMS public content endpoint.
# Example:
# VITE_CONTENT_BASE_URL=https://your-cms.vercel.app/api/content
VITE_CONTENT_BASE_URL=/api/content

# Optional public key passed as x-content-public-key header to content requests.
# This should match CONTENT_PUBLIC_KEY in the CMS backend.
VITE_CONTENT_BASE_PUBLIC_KEY=

# Optional Stripe public key for future store checkout wiring
VITE_STRIPE_PUBLISHABLE_KEY=

#EMAIL CONTACT US 
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
